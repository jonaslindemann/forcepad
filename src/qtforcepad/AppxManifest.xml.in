<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for ForcePAD 2.

  Generated by CMake (see the MSIX block in src/qtforcepad/CMakeLists.txt):
    @VAR@ placeholders are substituted by configure_file(), and the generator
    expression on Application/@Executable is resolved afterwards by
    file(GENERATE), so the name follows DEBUG_POSTFIX for Debug builds.

  Careful when editing: file(GENERATE) parses the WHOLE file for generator
  expressions, comments included, so a literal dollar-angle-bracket sequence
  anywhere in here is a configure error.

  Identity/Publisher MUST match what is reserved in Partner Center before a
  Store submission will be accepted - set FORCEPAD_MSIX_IDENTITY_NAME and
  FORCEPAD_MSIX_PUBLISHER at configure time. The defaults are development
  placeholders and are only good for locally signed sideloading.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <!-- The Store rejects a non-zero fourth version component; CMake derives
       this from FORCEPAD_VERSION and pins the revision to 0. -->
  <Identity
      Name="@FORCEPAD_MSIX_IDENTITY_NAME@"
      Publisher="@FORCEPAD_MSIX_PUBLISHER@"
      Version="@FORCEPAD_MSIX_VERSION@"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>ForcePAD 2</DisplayName>
    <PublisherDisplayName>@FORCEPAD_MSIX_PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
        Name="Windows.Desktop"
        MinVersion="10.0.17763.0"
        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <!-- runFullTrust is what makes this a packaged *desktop* (Win32) app rather
       than a UWP one. It is a restricted capability, but it is auto-approved
       for desktop app submissions - no special request needed. It also covers
       ModelUrlLoader's outbound http(s) model downloads, so no separate
       internetClient capability is required. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application
        Id="ForcePAD2"
        Executable="$<TARGET_FILE_NAME:qtforcepad>"
        EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
          DisplayName="ForcePAD 2"
          Description="Sketch-based finite element analysis for engineering education."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Wide310x150Logo.png"
            Square310x310Logo="Assets\LargeTile.png"
            Square71x71Logo="Assets\SmallTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Replaces the [Registry] block of install/win32/forcepad2.iss.
             A packaged app cannot write HKCR itself; file associations have
             to be declared here or they do not exist. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="fp2">
            <uap:DisplayName>ForcePAD2 File</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.fp2</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>

    </Application>
  </Applications>
</Package>
